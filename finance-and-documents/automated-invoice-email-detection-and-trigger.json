    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert invoice data extraction assistant. Extract all relevant information from the invoice text with high accuracy. Pay special attention to: vendor name and contact details, invoice number and date, line items with descriptions, quantities, unit prices and totals, subtotal, tax amounts, and final total, currency, payment terms, and purchase order number if present. Be precise with numbers and dates."
        }
      },
      "id": "97efdd17-28c4-4742-aab1-90f621b4f5b4",
      "name": "Claude Invoice Parser",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1152,
        668
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-3-5-sonnet-20241022"
        },
        "options": {
          "temperature": 0.1
        }
      },
      "id": "c451eed6-40b5-4f52-a7db-66fbe2c9cfab",
      "name": "Claude Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1160,
        892
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n\t\"type\": \"object\",\n\t\"properties\": {\n\t\t\"vendor_name\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Name of the vendor or company issuing the invoice\"\n\t\t},\n\t\t\"invoice_number\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Unique invoice identifier\"\n\t\t},\n\t\t\"invoice_date\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Date the invoice was issued\"\n\t\t},\n\t\t\"line_items\": {\n\t\t\t\"type\": \"array\",\n\t\t\t\"items\": {\n\t\t\t\t\"type\": \"object\",\n\t\t\t\t\"properties\": {\n\t\t\t\t\t\"description\": {\n\t\t\t\t\t\t\"type\": \"string\",\n\t\t\t\t\t\t\"description\": \"Description of the item or service\"\n\t\t\t\t\t},\n\t\t\t\t\t\"quantity\": {\n\t\t\t\t\t\t\"type\": \"number\",\n\t\t\t\t\t\t\"description\": \"Quantity of items\"\n\t\t\t\t\t},\n\t\t\t\t\t\"unit_price\": {\n\t\t\t\t\t\t\"type\": \"number\",\n\t\t\t\t\t\t\"description\": \"Price per unit\"\n\t\t\t\t\t},\n\t\t\t\t\t\"total\": {\n\t\t\t\t\t\t\"type\": \"number\",\n\t\t\t\t\t\t\"description\": \"Total price for this line item\"\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t},\n\t\t\t\"description\": \"List of items or services on the invoice\"\n\t\t},\n\t\t\"subtotal\": {\n\t\t\t\"type\": \"number\",\n\t\t\t\"description\": \"Subtotal amount before tax\"\n\t\t},\n\t\t\"tax\": {\n\t\t\t\"type\": \"number\",\n\t\t\t\"description\": \"Tax amount\"\n\t\t},\n\t\t\"total_amount\": {\n\t\t\t\"type\": \"number\",\n\t\t\t\"description\": \"Total amount including tax\"\n\t\t},\n\t\t\"currency\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Currency code (e.g., USD, EUR, GBP)\"\n\t\t},\n\t\t\"payment_terms\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Payment terms (e.g., Net 30, Due on receipt)\"\n\t\t},\n\t\t\"purchase_order_number\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Purchase order number if applicable\"\n\t\t}\n\t},\n\t\"required\": [\"vendor_name\", \"invoice_number\", \"invoice_date\", \"total_amount\"]\n}"
      },
      "id": "f70a9846-ca32-401c-b3c5-4a86e204216c",
      "name": "Structured Invoice Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1288,
        892
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.vendor_name }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "isEmpty"
                    }
                  },
                  {
                    "leftValue": "={{ $json.invoice_number }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "isEmpty"
                    }
                  },
                  {
                    "leftValue": "={{ $json.total_amount }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "isEmpty"
                    }
                  }
                ],
                "combinator": "or"
              },
              "renameOutput": true,
              "outputKey": "Missing Required Data"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.total_amount }}",
                    "rightValue": "10000",
                    "operator": {
                      "type": "number",
                      "operation": "gt"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Requires Approval"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.vendor_name }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "isNotEmpty"
                    }
                  },
                  {
                    "leftValue": "={{ $json.total_amount }}",
                    "rightValue": "10000",
                    "operator": {
                      "type": "number",
                      "operation": "lte"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Auto-Approved"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
