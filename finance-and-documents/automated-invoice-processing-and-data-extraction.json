      "id": "9d2485a0-49ce-4a42-bee6-b63c0e4042a6",
      "name": "New Invoice File",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        240,
        400
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}",
          "cachedResultName": "={{ $json.name }}"
        },
        "options": {
          "binaryPropertyName": "fileData"
        }
      },
      "id": "f06dacc3-7e7b-4102-b735-31b120edee5f",
      "name": "Download File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        464,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const binaryData = $input.item.binary.fileData;\nconst base64String = binaryData.data;\nconst mimeType = binaryData.mimeType;\nconst fileName = binaryData.fileName;\n\nreturn {\n  json: {\n    base64: base64String,\n    mimeType: mimeType,\n    fileName: fileName,\n    fileId: $input.item.json.id,\n    originalName: $input.item.json.name\n  }\n};"
      },
      "id": "b0623b6a-adba-4d4d-b0e3-358c68ee6265",
      "name": "Convert to Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        400
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.mimeType }}",
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    },
                    "rightValue": "image/(jpeg|jpg|png)"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Image Files"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.mimeType }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "application/pdf"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "PDF Files"
            }
          ]
        },
        "options": {}
      },
      "id": "47c6fac3-8a8c-4366-a0f0-41059b276943",
      "name": "Route by File Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        912,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "<__PLACEHOLDER_VALUE__OCR API endpoint for images (e.g., https://api.ocr.space/parse/image)__>",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"base64Image\": \"data:\" + $json.mimeType + \";base64,\" + $json.base64, \"language\": \"eng\" } }}",
        "options": {}
      },
      "id": "98b5ffcf-d2d5-4b48-a78e-a4510863b044",
      "name": "OCR Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1136,
        304
      ]
    },
    {
      "parameters": {},
