        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"base64Image\": \"data:\" + $json.mimeType + \";base64,\" + $json.base64, \"language\": \"eng\", \"isTable\": true } }}",
        "options": {}
      },
      "id": "2660c5dd-a483-4025-91b7-7f4309c5ff1d",
