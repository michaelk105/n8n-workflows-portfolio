    {
      "parameters": {
        "text": "={{ JSON.stringify($json) }}",
        "attributes": {
          "attributes": [
            {
              "name": "vendor_name",
              "description": "Name of the vendor or supplier",
              "required": true
            },
            {
              "name": "total_amount",
              "type": "number",
              "description": "Total amount of the invoice or receipt",
              "required": true
            },
            {
              "name": "invoice_number",
              "description": "Invoice or receipt number"
            },
            {
              "name": "date",
              "type": "date",
              "description": "Invoice or receipt date",
              "required": true
            },
            {
              "name": "due_date",
              "type": "date",
              "description": "Payment due date (if available)"
            },
            {
              "name": "document_type",
              "description": "Type of document: invoice or receipt",
              "required": true
            },
            {
              "name": "category",
              "description": "Expense category (e.g., Office Supplies, Travel, Meals)"
            }
          ]
        },
        "options": {}
      },
      "id": "8a8233f8-c2ee-4993-b103-e0499cf980ba",
      "name": "AI Extract Structured Data",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1920,
        368
      ]
    },
    {
      "parameters": {
        "resource": "bill",
        "operation": "create",
        "VendorRef": "={{ $json.vendor_name }}",
        "Line": [
          {
            "Amount": "={{ $json.total_amount }}",
            "Description": "={{ $json.document_type }} - {{ $json.invoice_number ?? \"No invoice number\" }} - {{ $json.category ?? \"General Expense\" }}",
            "DetailType": "AccountBasedExpenseLineDetail",
            "LineNum": 1
          }
        ],
        "additionalFields": {
          "DueDate": "={{ $json.due_date ?? $json.date }}",
          "TotalAmt": "={{ $json.total_amount }}",
          "TxnDate": "={{ $json.date }}"
        }
      },
      "id": "bd0a602a-7081-42c0-aadf-01590264bb88",
