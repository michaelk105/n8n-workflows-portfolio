      "position": [
        1152,
        304
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an invoice comparison assistant. Compare the customer invoice with the Printify store invoice and identify: 1) Matching items and quantities, 2) Price discrepancies, 3) Missing or extra items, 4) Any billing errors. Provide a clear summary of findings and recommend next steps."
        }
      },
      "id": "78f0765e-9208-4531-ab80-b5c6f6c21140",
      "name": "Claude Invoice Analyzer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1376,
        304
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-3-5-sonnet-20241022"
        },
        "options": {}
      },
      "id": "bea51a7a-c3c0-4153-a510-844093742806",
      "name": "Claude Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1384,
        528
      ],
      "credentials": {
        "anthropicApi": {
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n\t\"type\": \"object\",\n\t\"properties\": {\n\t\t\"matchingItems\": {\n\t\t\t\"type\": \"array\",\n\t\t\t\"description\": \"Items that match between both invoices\"\n\t\t},\n\t\t\"discrepancies\": {\n\t\t\t\"type\": \"array\",\n\t\t\t\"description\": \"Price or quantity differences found\"\n\t\t},\n\t\t\"missingItems\": {\n\t\t\t\"type\": \"array\",\n\t\t\t\"description\": \"Items in customer invoice but not in Printify\"\n\t\t},\n\t\t\"extraItems\": {\n\t\t\t\"type\": \"array\",\n\t\t\t\"description\": \"Items in Printify but not in customer invoice\"\n\t\t},\n\t\t\"summary\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Overall comparison summary\"\n\t\t},\n\t\t\"recommendedAction\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Suggested next steps\"\n\t\t}\n\t},\n\t\"required\": [\"summary\", \"recommendedAction\"]\n}"
      },
