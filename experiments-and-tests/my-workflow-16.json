{
  "name": "My workflow 16",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "id": "989ff84e-08d1-43ec-9c18-2fe481a3cbc8",
      "name": "Check Stale Leads Every 4 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        432,
        112
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "keyValue": "Open"
            },
            {
              "keyName": "updatedAt",
              "condition": "lt",
              "keyValue": "={{ $now.minus(24, \"hours\").toISO() }}"
            }
          ]
        },
        "returnAll": true
      },
      "id": "d3b1290a-f130-4a7c-8b96-d1e2b6dfc487",
      "name": "Fetch Stale Leads",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        656,
        112
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "filters": {
          "conditions": [
            {
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "Stale - Follow Up Needed"
          }
        },
        "options": {}
      },
      "id": "66ea66aa-1415-40b5-bc9c-87827fc62bf6",
      "name": "Mark Lead as Stale",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        880,
        112
      ]
    },
    {
      "parameters": {
        "from": "<__PLACEHOLDER_VALUE__Your Twilio phone number__>",
        "to": "={{ $('Mark Lead as Stale').item.json.lead_phone }}",
        "message": "=Hi {{ $('Mark Lead as Stale').item.json.lead_name }}, just following up on your interest in {{ $('Mark Lead as Stale').item.json.property }}. Are you still looking for a place?",
        "options": {}
      },
      "id": "fb795067-0620-4753-973a-b485896a857a",
      "name": "Send Follow-up SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1104,
        112
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "text": "=⏰ *Stale Lead Alert*\n\n*Lead:* {{ $('Mark Lead as Stale').item.json.lead_name }}\n*Property:* {{ $('Mark Lead as Stale').item.json.property }}\n*Phone:* {{ $('Mark Lead as Stale').item.json.lead_phone }}\n*Assigned to:* {{ $('Mark Lead as Stale').item.json.assigned_rep }}\n*Status:* No response in 24 hours\n\n🔍 Manager review recommended",
        "otherOptions": {}
      },
      "id": "4de71ae5-3423-4f45-bf00-5a7c5d303125",
      "name": "Notify Leasing Manager",
