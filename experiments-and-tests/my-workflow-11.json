    {
      "parameters": {
        "jsCode": "const jobTrackerData = $('Read Job Tracker').all().map(i => i.json);\nconst paymentsData = $('Read Payments').all().map(i => i.json);\nconst payrollData = $('Read Payroll').all().map(i => i.json);\n\nconst paymentSummary = {};\npaymentsData.forEach(payment => {\n  const jobId = payment['Job ID'];\n  if (!paymentSummary[jobId]) {\n    paymentSummary[jobId] = { totalPaid: 0, lastPaymentDate: null };\n  }\n  paymentSummary[jobId].totalPaid += parseFloat(payment['Amount Paid'] || 0);\n  if (payment['Payment Date']) {\n    const paymentDate = new Date(payment['Payment Date']);\n    if (!paymentSummary[jobId].lastPaymentDate || paymentDate > paymentSummary[jobId].lastPaymentDate) {\n      paymentSummary[jobId].lastPaymentDate = payment['Payment Date'];\n    }\n  }\n});\n\nconst payrollSummary = {};\npayrollData.forEach(payroll => {\n  const jobId = payroll['Job ID'];\n  if (!payrollSummary[jobId]) {\n    payrollSummary[jobId] = { totalHours: 0, totalPay: 0, employeeCount: 0 };\n  }\n  payrollSummary[jobId].totalHours += parseFloat(payroll['Hours Worked'] || 0);\n  payrollSummary[jobId].totalPay += parseFloat(payroll['Total Pay'] || 0);\n  payrollSummary[jobId].employeeCount += 1;\n});\n\nconst results = jobTrackerData.map(job => {\n  const jobId = job['Job ID'];\n  const totalDue = parseFloat(job['Total Due'] || 0);\n  const payments = paymentSummary[jobId] || { totalPaid: 0, lastPaymentDate: null };\n  const balanceDue = totalDue - payments.totalPaid;\n  const payroll = payrollSummary[jobId] || { totalHours: 0, totalPay: 0, employeeCount: 0 };\n  \n  let paymentStatus = 'Unpaid';\n  if (balanceDue <= 0) {\n    paymentStatus = 'Paid';\n  } else if (payments.totalPaid > 0) {\n    paymentStatus = 'Partial';\n  }\n  \n  const hasChanges = true;\n  \n  return {\n    json: {\n      'Job ID': jobId,\n      'Client': job['Client'],\n      'Hours': job['Hours'],\n      'Rate': job['Rate'],\n      'Status': job['Status'],\n      'Total Due': totalDue,\n      'Total Paid': payments.totalPaid,\n      'Balance Due': balanceDue,\n      'Payment Status': paymentStatus,\n      'Last Payment Date': payments.lastPaymentDate,\n      'Payroll Hours': payroll.totalHours,\n      'Payroll Total': payroll.totalPay,\n      'Employee Count': payroll.employeeCount,\n      'Has Changes': hasChanges,\n      'Last Updated': job['Last Updated'] || new Date().toISOString()\n    }\n  };\n});\n\nreturn results;"
      },
