      "id": "59ae8903-c1e7-4ac2-86d3-aeefe5db2ab0",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1024,
        32
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const emergencyKeywords = [\n  'leak', 'leaking', 'water coming in', 'tarp', 'storm damage',\n  'tree fell', 'ceiling collapse', 'hail damage', 'active rain damage',\n  'urgent', 'emergency'\n];\n\nconst description = ($json.roof_issue_description || '').toLowerCase();\nconst notes = ($json.notes || '').toLowerCase();\nconst summary = ($json.call_summary || '').toLowerCase();\n\nconst combinedText = description + ' ' + notes + ' ' + summary;\n\nconst hasEmergencyKeyword = emergencyKeywords.some(keyword => \n  combinedText.includes(keyword.toLowerCase())\n);\n\nreturn {\n  ...($json),\n  emergency_keywords_detected: hasEmergencyKeyword ? 'yes' : $json.emergency_keywords_detected\n};"
      },
      "id": "217e1bfe-2708-4e06-a05b-df4864476efa",
      "name": "Detect Emergency Keywords",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        32
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const activeDamage = ($json.active_damage || '').toLowerCase() === 'yes';\nconst emergencyKeywords = ($json.emergency_keywords_detected || '').toLowerCase() === 'yes';\nconst urgencyScore = parseInt($json.urgency_score) || 0;\n\nlet branch = 'Cold';\n\nif (activeDamage || emergencyKeywords || urgencyScore >= 9) {\n  branch = 'Emergency';\n} else if (urgencyScore >= 7) {\n  branch = 'Hot';\n} else if (urgencyScore >= 4) {\n  branch = 'Warm';\n}\n\nreturn {\n  ...($json),\n  branch: branch\n};"
      },
      "id": "01167b83-142e-4652-9cb5-4fd7f761017d",
      "name": "Determine Branch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -576,
        32
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.branch }}",
                    "rightValue": "Emergency",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                }
              },
              "renameOutput": true,
              "outputKey": "Emergency"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.branch }}",
                    "rightValue": "Hot",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                }
              },
              "renameOutput": true,
              "outputKey": "Hot"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.branch }}",
                    "rightValue": "Warm",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                }
              },
              "renameOutput": true,
              "outputKey": "Warm"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Cold"
        }
      },
