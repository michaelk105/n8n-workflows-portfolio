    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "text": "=⚠️ *Manual Override Detected*\n\n*Job ID:* {{ $json[\"Job ID\"] }}\n*Client:* {{ $json[\"Client\"] }}\n*Data Source:* {{ $json[\"Data_Source\"] }}\n\nThis record is marked for manual review and will not be auto-synced.",
        "otherOptions": {}
      },
      "id": "c183aeca-6ea4-49cc-baa9-262c320be6f1",
      "name": "Notify Manual Override",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [
        1360,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "const jobTrackerData = $('Read Job Tracker').all().map(i => i.json);\nconst paymentsData = $('Read Payments').all().map(i => i.json);\nconst payrollData = $('Read Payroll').all().map(i => i.json);\n\nconst validRecords = [];\nconst invalidRecords = [];\n\nconst paymentSummary = {};\npaymentsData.forEach(payment => {\n  const jobId = payment['Job ID'];\n  if (!paymentSummary[jobId]) {\n    paymentSummary[jobId] = { totalPaid: 0, lastPaymentDate: null };\n  }\n  paymentSummary[jobId].totalPaid += parseFloat(payment['Amount Paid'] || 0);\n  if (payment['Payment Date']) {\n    const paymentDate = new Date(payment['Payment Date']);\n    if (!paymentSummary[jobId].lastPaymentDate || paymentDate > paymentSummary[jobId].lastPaymentDate) {\n      paymentSummary[jobId].lastPaymentDate = payment['Payment Date'];\n    }\n  }\n});\n\nconst payrollSummary = {};\npayrollData.forEach(payroll => {\n  const jobId = payroll['Job ID'];\n  if (!payrollSummary[jobId]) {\n    payrollSummary[jobId] = { totalHours: 0, totalPay: 0, employeeCount: 0 };\n  }\n  payrollSummary[jobId].totalHours += parseFloat(payroll['Hours Worked'] || 0);\n  payrollSummary[jobId].totalPay += parseFloat(payroll['Total Pay'] || 0);\n  payrollSummary[jobId].employeeCount += 1;\n});\n\njobTrackerData.forEach(job => {\n  const jobId = job['Job ID'];\n  const hours = parseFloat(job['Hours'] || 0);\n  const rate = parseFloat(job['Rate'] || 0);\n  const totalDue = parseFloat(job['Total Due'] || 0);\n  \n  const validationErrors = [];\n  \n  if (hours < 0 || hours > 24) {\n    validationErrors.push('Hours must be between 0 and 24');\n  }\n  \n  if (rate < 0 || rate > 500) {\n    validationErrors.push('Rate must be between 0 and 500');\n  }\n  \n  if (!jobId || jobId === '') {\n    validationErrors.push('Job ID is required');\n  }\n  \n  const payments = paymentSummary[jobId] || { totalPaid: 0, lastPaymentDate: null };\n  const balanceDue = totalDue - payments.totalPaid;\n  const payroll = payrollSummary[jobId] || { totalHours: 0, totalPay: 0, employeeCount: 0 };\n  \n  let paymentStatus = 'Unpaid';\n  if (balanceDue <= 0) {\n    paymentStatus = 'Paid';\n  } else if (payments.totalPaid > 0) {\n    paymentStatus = 'Partial';\n  }\n  \n  const recordData = {\n    'Job ID': jobId,\n    'Client': job['Client'],\n    'Hours': hours,\n    'Rate': rate,\n    'Status': job['Status'],\n    'Total Due': totalDue,\n    'Total Paid': payments.totalPaid,\n    'Balance Due': balanceDue,\n    'Payment Status': paymentStatus,\n    'Last Payment Date': payments.lastPaymentDate,\n    'Payroll Hours': payroll.totalHours,\n    'Payroll Total': payroll.totalPay,\n    'Employee Count': payroll.employeeCount,\n    'Last_Modified': job['Last_Modified'] || new Date().toISOString(),\n    'Sync_Flag': '',\n    'Data_Source': job['Data_Source'] || ''\n  };\n  \n  if (validationErrors.length > 0) {\n    invalidRecords.push({\n      json: {\n        ...recordData,\n        'Validation_Errors': validationErrors.join('; '),\n        'Error_Timestamp': new Date().toISOString()\n      }\n    });\n  } else {\n    validRecords.push({\n      json: recordData\n    });\n  }\n});\n\nreturn validRecords.length > 0 ? validRecords : [{ json: { message: 'No valid records to process' } }];"
      },
