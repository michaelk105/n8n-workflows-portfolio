      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "<__PLACEHOLDER_VALUE__admin@company.com__>",
        "subject": "=⚠️ Team Notification Failed - {{ $(\"Extract Call Data\").item.json.callerPhone }}",
        "message": "=<h3>Team Notification Failed</h3><p><strong>Caller:</strong> {{ $(\"Extract Call Data\").item.json.callerName }} ({{ $(\"Extract Call Data\").item.json.callerPhone }})</p><p><strong>Call Time:</strong> {{ $(\"Extract Call Data\").item.json.callTime }}</p><p><strong>Error:</strong> {{ $json.message || \"Unknown error\" }}</p>",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "name": "Gmail account"
        }
      }
    }
