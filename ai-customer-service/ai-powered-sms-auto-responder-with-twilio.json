          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.output }}",
              "operator": {
                "type": "string",
                "operation": "exists"
              },
              "rightValue": ""
            }
          ]
        },
        "options": {}
      },
      "id": "fa029370-6a16-4c79-8797-5b9ed1f07660",
