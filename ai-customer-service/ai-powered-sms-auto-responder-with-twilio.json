      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1264,
        400
      ]
    },
    {
      "parameters": {
        "from": "<__PLACEHOLDER_VALUE__Your Twilio WhatsApp number (e.g. whatsapp:+15551234567)__>",
        "to": "={{ $json.senderPhone }}",
        "toWhatsapp": true,
        "message": "={{ $json.fallbackMessage }}",
        "options": {}
      },
      "id": "982a8c2c-5e07-43c0-870f-232ca639c864",
