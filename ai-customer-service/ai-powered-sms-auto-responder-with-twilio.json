        400
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "<__PLACEHOLDER_VALUE__twilio-whatsapp (configure this URL in your Twilio WhatsApp settings)__>",
        "options": {}
      },
      "id": "d7000432-7ee8-46f5-8bbe-c03eb5d7afb5",
      "name": "Receive WhatsApp from Twilio",
