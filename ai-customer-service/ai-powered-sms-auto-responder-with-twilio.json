      "typeVersion": 3.1,
      "position": [
        688,
        304
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-5-20250929"
        },
        "options": {}
      },
      "id": "5a681580-9c61-47be-bd66-eee3e0361e31",
