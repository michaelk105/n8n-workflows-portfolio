      "typeVersion": 2.3,
      "position": [
        1040,
        304
      ]
    },
    {
      "parameters": {
        "from": "<__PLACEHOLDER_VALUE__Your Twilio WhatsApp number (e.g. whatsapp:+15551234567)__>",
        "to": "={{ $(\"Extract WhatsApp Data\").item.json.senderPhone }}",
        "toWhatsapp": true,
        "message": "={{ $json.output }}",
        "options": {}
      },
      "id": "32e2b879-fdb1-4d97-8b4f-3f420628982d",
      "name": "Send AI Reply",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1264,
        208
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "fallbackMessage",
              "value": "Sorry, something went wrong. Please try again later.",
              "type": "string"
            },
            {
              "id": "2",
              "name": "senderPhone",
              "value": "={{ $(\"Extract WhatsApp Data\").item.json.senderPhone }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "da98dc42-7429-4ff9-9f0c-d1f3c2352f86",
