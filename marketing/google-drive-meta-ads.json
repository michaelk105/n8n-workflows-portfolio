{
  "name": "Google Drive - Meta ads",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "7b4728a6-7d65-45af-bccf-4b7853f765a0",
      "name": "Every Monday 8 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        304
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "query",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "mode": "list",
            "value": ""
          },
          "whatToSearch": "files"
        },
        "options": {
          "fields": [
            "id",
            "name",
            "mimeType",
            "webViewLink"
          ]
        }
      },
      "id": "3478abfd-384f-42b9-9778-05354706f1d7",
      "name": "Get Ready Assets",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [{ json: { has_asset: false } }];\n}\n\n// Use first item (most recently added based on Drive API default sort)\nconst mostRecent = items[0].json;\n\n// Determine file type\nlet fileType = 'unknown';\nif (mostRecent.mimeType.startsWith('image/')) {\n  fileType = 'image';\n} else if (mostRecent.mimeType.startsWith('video/')) {\n  fileType = 'video';\n}\n\nreturn [{\n  json: {\n    has_asset: true,\n    file_id: mostRecent.id,\n    file_name: mostRecent.name,\n    file_type: fileType,\n    drive_link: mostRecent.webViewLink,\n    mime_type: mostRecent.mimeType\n  }\n}];"
      },
      "id": "f23ad39b-f0c9-4e5d-bddb-ee21f960a0df",
      "name": "Select Next Asset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.has_asset }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "c56cf7d3-2f4b-45bc-97e1-5a2c0f6e243f",
      "name": "Asset Available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        912,
        304
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "ad_account_id",
              "value": "<__PLACEHOLDER_VALUE__Meta Ad Account ID (e.g., 123456789)__>",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "8bf42a64-c852-44f9-8df7-83d1f2406276",
      "name": "Add Meta Account ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1136,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/act_{{ $json.ad_account_id }}/adimages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $(\"Select Next Asset\").item.json.drive_link }}"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {
              "maxRedirects": 5
            }
          },
          "timeout": 30000
        }
      },
      "id": "ebe6aa8b-d59a-4097-9128-367b225f0e2b",
      "name": "Upload Creative to Meta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1360,
        400
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "campaign_id",
              "value": "<__PLACEHOLDER_VALUE__Meta Campaign ID__>",
              "type": "string"
            },
            {
              "id": "2",
              "name": "adset_id",
              "value": "<__PLACEHOLDER_VALUE__Meta Ad Set ID__>",
              "type": "string"
            },
            {
              "id": "3",
              "name": "creative_hash",
              "value": "={{ $json.images.hash }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "96401591-4f3c-42ea-b271-dfdd10f27fbe",
      "name": "Add Campaign Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1584,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/act_{{ $json.ad_account_id }}/ads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"name\": \"Client Brand - \" + $(\"Select Next Asset\").item.json.file_name, \"adset_id\": $json.adset_id, \"creative\": { \"creative_id\": $json.campaign_id }, \"status\": \"PAUSED\" } }}",
        "options": {
          "redirect": {
            "redirect": {
              "maxRedirects": 5
            }
          }
        }
      },
      "id": "2b606eb4-a015-4bbf-b94e-00dcf9947450",
      "name": "Create Meta Ad Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1808,
        304
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "ad-automation"
        },
        "text": "=✅ Client Brand Meta Ad Draft Ready!\n\n*Asset:* {{ $(\"Select Next Asset\").item.json.file_name }}\n*File Type:* {{ $(\"Select Next Asset\").item.json.file_type }}\n*Ad ID:* {{ $json.id }}\n*Status:* PAUSED (requires approval)\n\n👉 Log into Meta Ads Manager to review and publish the draft ad.",
        "otherOptions": {}
      },
      "id": "9519710e-6e3a-41a6-82b3-467c9750e195",
      "name": "Notify - Draft Ready for Review",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.5,
      "position": [
        2032,
        208
      ]
    },
    {
      "parameters": {
        "sendTo": "<__PLACEHOLDER_VALUE__admin@example.com__>",
        "subject": "Client Brand Meta Ad Draft Created - Review Required",
        "message": "=<h2>Client Brand Meta Ad Draft Created Successfully</h2><p>A new Meta ad draft has been created and is ready for your review.</p><h3>Asset Details:</h3><ul><li><strong>File Name:</strong> {{ $(\"Select Next Asset\").item.json.file_name }}</li><li><strong>File Type:</strong> {{ $(\"Select Next Asset\").item.json.file_type }}</li><li><strong>Drive Link:</strong> <a href=\"{{ $(\"Select Next Asset\").item.json.drive_link }}\">View in Google Drive</a></li><li><strong>Ad ID:</strong> {{ $(\"Create Meta Ad Draft\").item.json.id }}</li></ul><h3>⚠️ Important:</h3><p><strong>The ad is currently PAUSED and NOT live.</strong></p><p>Please log into Meta Ads Manager to:</p><ol><li>Review the ad creative and settings</li><li>Make any necessary adjustments</li><li>Manually publish the ad when ready</li></ol><p><em>Nothing goes live automatically. Human approval is required.</em></p>",
        "options": {}
      },
