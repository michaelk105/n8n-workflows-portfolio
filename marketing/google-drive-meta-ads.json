        "message": "=<h2>Meta Creative Upload Failed</h2><p><strong>Asset:</strong> {{ $(\"Select Next Asset\").item.json.file_name }}</p><p><strong>File Type:</strong> {{ $(\"Select Next Asset\").item.json.file_type }}</p><p><strong>Drive Link:</strong> <a href=\"{{ $(\"Select Next Asset\").item.json.drive_link }}\">{{ $(\"Select Next Asset\").item.json.drive_link }}</a></p><p><strong>Error:</strong> Request failed</p><p>Please check the Meta Marketing API credentials and try again.</p>",
        "options": {}
