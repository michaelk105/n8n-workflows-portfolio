    {
      "parameters": {
        "sendTo": "<__PLACEHOLDER_VALUE__admin@example.com__>",
        "subject": "=Client Brand Meta Ad - Draft Creation Failed for {{ $(\"Select Next Asset\").item.json.file_name }}",
        "message": "=<h2>Meta Ad Draft Creation Failed</h2><p><strong>Asset:</strong> {{ $(\"Select Next Asset\").item.json.file_name }}</p><p><strong>File Type:</strong> {{ $(\"Select Next Asset\").item.json.file_type }}</p><p><strong>Creative Hash:</strong> {{ $(\"Add Campaign Parameters\").item.json.creative_hash }}</p><p><strong>Error:</strong> Request failed</p><p>The creative was uploaded successfully, but the ad draft creation failed. Please check the Campaign ID and Ad Set ID.</p>",
        "options": {}
