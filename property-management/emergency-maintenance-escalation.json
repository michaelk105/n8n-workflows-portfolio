        112
      ]
    },
    {
      "parameters": {
        "content": "## Setup Instructions\n\n1. Configure webhook URL in AppFolio\n2. Set Slack channel names\n3. Add SMTP credentials\n4. Add Twilio credentials for SMS\n5. Update email addresses and phone numbers",
        "height": 200,
        "width": 400,
        "color": 4
      },
      "id": "7752ab30-29da-4032-b66a-2c861dc55328",
      "name": "Sticky Note 2ec3e05b",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1104,
        64
      ]
    }
