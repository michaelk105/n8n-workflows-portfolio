    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"claude-sonnet-4-20250514\", \"max_tokens\": 500, \"system\": \"You are a maintenance request triage assistant. Analyze the maintenance request and return ONLY a valid JSON object with these exact fields: urgency (must be one of: emergency, urgent, routine), category (must be one of: plumbing, electrical, HVAC, appliance, structural, pest, other), missing_info (array of strings describing any missing details needed), summary (one sentence summary), tenant_reply_draft (a short friendly message to send back to the tenant).\", \"messages\": [{ \"role\": \"user\", \"content\": \"Tenant: \" + $json.tenant_name + \"\\nUnit: \" + $json.unit_number + \"\\nMessage: \" + $json.message }] } }}",
        "options": {
          "response": {
            "response": {}
          },
          "timeout": 15000
        }
      },
      "id": "4ae7bbb8-294b-41d8-b463-8270668ad401",
      "name": "Claude - Triage Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1136,
        496
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const validateInput = $('Validate Input').item.json;\nlet result;\n\ntry {\n  const responseText = $json.content[0].text;\n  const parsed = JSON.parse(responseText);\n  \n  // Validate urgency\n  const validUrgencies = ['emergency', 'urgent', 'routine'];\n  let urgency = parsed.urgency;\n  let manual_review_reason = '';\n  \n  if (!validUrgencies.includes(urgency)) {\n    manual_review_reason = 'Invalid urgency value: ' + urgency;\n    urgency = 'routine';\n  }\n  \n  // Compute route\n  let route;\n  if (manual_review_reason) {\n    route = 'manual_review';\n  } else if (parsed.missing_info && parsed.missing_info.length > 0) {\n    route = 'missing_info';\n  } else if (urgency === 'emergency') {\n    route = 'emergency';\n  } else {\n    route = 'standard';\n  }\n  \n  result = {\n    ...validateInput,\n    urgency: urgency,\n    category: parsed.category || 'other',\n    missing_info: parsed.missing_info || [],\n    summary: parsed.summary || 'No summary provided',\n    tenant_reply_draft: parsed.tenant_reply_draft || 'Thank you for your request.',\n    route: route,\n    manual_review_reason: manual_review_reason\n  };\n} catch (error) {\n  result = {\n    ...validateInput,\n    route: 'manual_review',\n    manual_review_reason: 'Failed to parse Claude response: ' + error.message,\n    urgency: 'routine',\n    category: 'other',\n    missing_info: [],\n    summary: 'Parse error',\n    tenant_reply_draft: 'Thank you for your request.'\n  };\n}\n\nreturn result;"
      },
