    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $input.item.json.body || {};\nconst requiredFields = ['tenant_name', 'unit_number', 'contact', 'message'];\nconst missingFields = [];\n\nfor (const field of requiredFields) {\n  if (!body[field] || String(body[field]).trim() === '') {\n    missingFields.push(field);\n  }\n}\n\nreturn {\n  ...body,\n  valid: missingFields.length === 0,\n  error_reason: missingFields.length > 0 ? 'Missing required fields: ' + missingFields.join(', ') : ''\n};"
      },
      "id": "7da987fd-b2dd-4e5a-be77-b71c16f430fb",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
