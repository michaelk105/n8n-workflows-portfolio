    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return { has_items: false };\n}\n\nconst lines = items.map(item => {\n  const data = item.json;\n  return `• ${data.Tenant} - Unit ${data.Unit} - ${data.Status} - ${data.Date} - ${data.Summary}`;\n});\n\nreturn {\n  has_items: true,\n  digest_text: lines.join('\\n'),\n  count: items.length\n};"
      },
      "id": "6f9e8d0a-827f-4cf9-94b1-4df48f9fc9ac",
      "name": "Format Digest",
      "type": "n8n-nodes-base.code",
