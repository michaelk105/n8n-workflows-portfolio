    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $credentials.anthropicApi.apiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 500,\n  \"system\": \"You are a maintenance request triage assistant for a property management company. Read the tenant's message and respond with ONLY a JSON object (no other text) with these fields: urgency (one of: emergency, urgent, routine), category (plumbing, electrical, HVAC, appliance, structural, pest, other), missing_info (array of strings - empty array if nothing is missing), summary (one sentence summary for the property manager), tenant_reply_draft (a short, friendly acknowledgment message to send back to the tenant).\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Tenant: {{$json.tenant_name}}\\nUnit: {{$json.unit_number}}\\nMessage: {{$json.message}}\" }\n  ]\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "3667cbdc-75cd-4e53-bd00-d7bac8addda1",
      "name": "Claude - Triage Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        192,
        16
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const allowedUrgency = ['emergency', 'urgent', 'routine'];\nconst trigger = $('Maintenance Request Webhook1').first().json;\nlet parsed;\n\ntry {\n  const raw = $input.first().json.content[0].text;\n  parsed = JSON.parse(raw);\n} catch (err) {\n  return [{\n    json: {\n      tenant_name: trigger.tenant_name,\n      unit_number: trigger.unit_number,\n      contact: trigger.contact,\n      original_message: trigger.message,\n      route: 'manual_review',\n      manual_review_reason: 'Could not parse Claude response',\n      received_at: new Date().toISOString()\n    }\n  }];\n}\n\nlet manualReviewReason = null;\nif (!allowedUrgency.includes(parsed.urgency)) {\n  parsed.urgency = 'routine';\n  manualReviewReason = 'Unexpected urgency value from Claude';\n}\n\nlet route = 'standard';\nif (parsed.missing_info && parsed.missing_info.length > 0) {\n  route = 'missing_info';\n} else if (parsed.urgency === 'emergency') {\n  route = 'emergency';\n}\n\nreturn [{\n  json: {\n    tenant_name: trigger.tenant_name,\n    unit_number: trigger.unit_number,\n    contact: trigger.contact,\n    original_message: trigger.message,\n    urgency: parsed.urgency,\n    category: parsed.category,\n    missing_info: parsed.missing_info || [],\n    summary: parsed.summary,\n    tenant_reply_draft: parsed.tenant_reply_draft,\n    route: route,\n    manual_review_reason: manualReviewReason,\n    received_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "8502f466-1604-4824-ad10-2591fcdbdbb4",
      "name": "Parse Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
