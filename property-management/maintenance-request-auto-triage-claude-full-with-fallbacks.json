      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst required = ['tenant_name', 'unit_number', 'contact', 'message'];\nconst missing = required.filter(field => !body[field] || String(body[field]).trim() === '');\n\nreturn [{\n  json: {\n    ...body,\n    valid: missing.length === 0,\n    error_reason: missing.length > 0 ? ('Missing required field(s): ' + missing.join(', ')) : null\n  }\n}];"
      },
