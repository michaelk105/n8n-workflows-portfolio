      "id": "706f3e08-b730-4f18-a178-1f647d92d4e8",
      "name": "Suppress Duplicate",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2704,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const errorLog = $input.first();\nconst errorEvent = $input.item.json;\n\nlet occurrence_count = 1;\nlet first_occurrence_timestamp = errorEvent.current_timestamp;\nlet last_occurrence_timestamp = errorEvent.current_timestamp;\n\nif (errorLog && errorLog.error_key) {\n  occurrence_count = (errorLog.occurrence_count || 0) + 1;\n  first_occurrence_timestamp = errorLog.first_occurrence_timestamp || errorEvent.current_timestamp;\n  last_occurrence_timestamp = errorEvent.current_timestamp;\n}\n\nreturn {\n  ...errorEvent,\n  occurrence_count,\n  first_occurrence_timestamp,\n  last_occurrence_timestamp\n};"
      },
      "id": "6c800134-290a-4b5f-8aff-1c789ddfb5cf",
      "name": "Update Failure Counter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        1632
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst firstOccurrence = new Date(item.first_occurrence_timestamp);\nconst now = new Date(item.current_timestamp);\nconst hoursDiff = (now - firstOccurrence) / (1000 * 60 * 60);\n\nlet escalated = false;\nif (item.occurrence_count >= 3 && hoursDiff <= 24) {\n  escalated = true;\n}\n\nreturn {\n  ...item,\n  escalation_triggered: escalated\n};"
      },
      "id": "a1924c00-78e8-4efa-b3d7-eac452536ca1",
      "name": "Check Escalation Threshold",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        1632
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\n\nif (!item.escalation_triggered) {\n  return item;\n}\n\nconst severityMap = {\n  Low: \"Medium\",\n  Medium: \"High\",\n  High: \"Critical\"\n};\n\nconst newSeverity = severityMap[item.severity] || item.severity;\n\nreturn {\n  ...item,\n  severity: newSeverity,\n  severity_escalated: true,\n  original_severity: item.severity\n};"
      },
      "id": "0dd08159-45c9-40a8-aa57-1def2ee1c21c",
      "name": "Escalate Severity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
