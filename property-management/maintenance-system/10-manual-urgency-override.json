          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.old_urgency === \"Normal\" && ($json.body.new_urgency === \"Urgent\" || $json.body.new_urgency === \"Emergency\") }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": ""
            },
            {
              "leftValue": "={{ $json.body.old_urgency === \"Urgent\" && ($json.body.new_urgency === \"Emergency\" || $json.body.new_urgency === \"Normal\") }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": ""
            },
            {
              "leftValue": "={{ $json.body.old_urgency === \"Emergency\" && ($json.body.new_urgency === \"Urgent\" || $json.body.new_urgency === \"Normal\") && $json.body.manager_approval === \"yes\" }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": ""
