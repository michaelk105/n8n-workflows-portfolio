      "id": "7854795f-a23d-4196-8356-0d542adcc9a2",
      "name": "Validate Change",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const { DateTime } = require(\"luxon\");\n\nconst item = $input.first();\nconst urgency = item.json.body.new_urgency;\nlet slaDeadline;\n\nif (urgency === \"Emergency\") {\n  slaDeadline = DateTime.now().plus({ minutes: 15 }).toISO();\n} else if (urgency === \"Urgent\") {\n  let deadline = DateTime.now();\n  let hoursAdded = 0;\n  while (hoursAdded < 4) {\n    deadline = deadline.plus({ hours: 1 });\n    const dayOfWeek = deadline.weekday;\n    const hour = deadline.hour;\n    if (dayOfWeek >= 1 && dayOfWeek <= 5 && hour >= 9 && hour < 17) {\n      hoursAdded++;\n    }\n  }\n  slaDeadline = deadline.toISO();\n} else {\n  let deadline = DateTime.now();\n  let daysAdded = 0;\n  while (daysAdded < 1) {\n    deadline = deadline.plus({ days: 1 });\n    const dayOfWeek = deadline.weekday;\n    if (dayOfWeek >= 1 && dayOfWeek <= 5) {\n      daysAdded++;\n    }\n  }\n  deadline = deadline.set({ hour: 17, minute: 0, second: 0 });\n  slaDeadline = deadline.toISO();\n}\n\nreturn [{\n  json: {\n    ...item.json.body,\n    sla_deadline: slaDeadline\n  }\n}];"
      },
