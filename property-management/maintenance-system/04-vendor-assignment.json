      "parameters": {
        "jsCode": "// Vendor assignment logic based on issue category, property, urgency, and availability\nconst item = $input.first();\n\n// Vendor database (in production, this would be fetched from a database)\nconst vendors = {\n  'Plumbing': { name: 'ABC Plumbing', contact: 'vendor@abcplumbing.com', phone: '+1-555-0100' },\n  'Electrical': { name: 'XYZ Electric', contact: 'vendor@xyzelectric.com', phone: '+1-555-0200' },\n  'HVAC': { name: 'Cool Air HVAC', contact: 'vendor@coolairhvac.com', phone: '+1-555-0300' },\n  'Appliance': { name: 'Fix-It Appliances', contact: 'vendor@fixitappliances.com', phone: '+1-555-0400' }\n};\n\nconst issueCategory = item.json.issue_category || 'General';\nconst vendor = vendors[issueCategory];\n\nif (vendor) {\n  return [{\n    json: {\n      ...item.json,\n      vendor_name: vendor.name,\n      vendor_contact: vendor.contact,\n      vendor_phone: vendor.phone,\n      vendor_found: true\n    }\n  }];\n} else {\n  return [{\n    json: {\n      ...item.json,\n      vendor_found: false,\n      status: 'Vendor assignment needed'\n    }\n  }];\n}"
      },
