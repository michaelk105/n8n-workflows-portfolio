    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const status = $input.item.json.status;\nconst tenant_name = $input.item.json.tenant_name;\nconst work_order_id = $input.item.json.work_order_id;\nconst scheduled_date_time = $input.item.json.scheduled_date_time;\nconst delay_reason = $input.item.json.delay_reason;\nconst tenant_phone = $input.item.json.tenant_phone;\nconst tenant_email = $input.item.json.tenant_email;\nconst message_type = $input.item.json.message_type;\n\nlet message_template = '';\n\nif (status === 'Vendor Assigned') {\n  message_template = `Hi ${tenant_name}, your maintenance request ${work_order_id} has been assigned to our maintenance team/vendor. We'll keep you updated as it moves forward.`;\n} else if (status === 'Scheduled') {\n  message_template = `Hi ${tenant_name}, your maintenance request ${work_order_id} has been scheduled for ${scheduled_date_time}.`;\n} else if (status === 'In Progress') {\n  message_template = `Hi ${tenant_name}, your maintenance request ${work_order_id} is currently in progress.`;\n} else if (status === 'Delayed') {\n  message_template = `Hi ${tenant_name}, your maintenance request ${work_order_id} is still open. We are waiting on ${delay_reason} and will keep you updated.`;\n}\n\nreturn { \n  message_template,\n  work_order_id,\n  tenant_name,\n  tenant_phone,\n  tenant_email,\n  status,\n  message_type,\n  scheduled_date_time,\n  delay_reason\n};"
      },
